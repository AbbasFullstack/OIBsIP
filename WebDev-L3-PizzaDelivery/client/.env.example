# Copy this file to `.env`. Vite only exposes variables prefixed with VITE_.

# Base URL of the Express API. When running `npm run dev`, the Vite proxy also
# forwards `/api` to this host, so the app works with either value.
VITE_API_URL=http://localhost:5000/api

# Socket.io server origin (no `/api` suffix).
VITE_SOCKET_URL=http://localhost:5000

# NOTE: the Razorpay *key id* is deliberately NOT stored here. It is returned by
# the order-creation endpoint so the server remains the single source of truth.
# Only the key id is ever sent to the browser; the key secret stays server-side.
