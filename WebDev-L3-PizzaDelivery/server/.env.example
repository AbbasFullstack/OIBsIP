# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Server ----
# Port the Express API listens on.
PORT=5000
# `development` enables stack traces and verbose logs; use `production` in deploys.
NODE_ENV=development
# Origin of the React client. Used for CORS and for links inside emails.
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Local MongoDB or a MongoDB Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/pizza_delivery

# ---- Auth ----
# Long random string used to sign JWTs. Regenerate for every deployment.
JWT_SECRET=replace-with-a-long-random-secret
# Access-token lifetime (e.g. 7d, 12h, 60m).
JWT_EXPIRES_IN=7d
# Minutes an email-verification link stays valid.
VERIFY_TOKEN_TTL_MIN=1440
# Minutes a password-reset link stays valid.
RESET_TOKEN_TTL_MIN=60
# bcrypt cost factor. 12 is a good production default.
BCRYPT_SALT_ROUNDS=12

# ---- Email (Nodemailer) ----
# For local dev, leave SMTP_HOST empty to use Nodemailer's Ethereal test
# account — messages are not really delivered, but each send logs a preview
# URL you can open in the browser.
SMTP_HOST=
SMTP_PORT=587
# `true` for port 465 (implicit TLS), `false` for 587/25 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# From header on outgoing mail.
MAIL_FROM="Pizza Delivery <no-reply@pizzadelivery.test>"

# ---- Razorpay (test mode) ----
# Dashboard → Settings → API Keys → Generate Test Key.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret
# Optional: the secret you configure on the Razorpay webhook (defaults to the key secret).
RAZORPAY_WEBHOOK_SECRET=

# ---- Scheduled stock alerts ----
# Cron expression (server timezone). Default: 09:00 and 21:00 every day.
STOCK_ALERT_CRON=0 9,21 * * *
# Where low-stock alert emails are sent.
STOCK_ALERT_EMAIL=admin@pizzadelivery.test

# ---- Seed admin account ----
# `npm run seed` upserts this admin. Change before any real deployment.
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@pizzadelivery.test
ADMIN_PASSWORD=Admin@12345
